# ============================================================
# TruthLens – Fake News Detection  |  Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- NewsAPI ---
# Get your free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=truthlens
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/truthlens

# --- JWT Authentication ---
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_very_long_random_secret_key_here_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- App Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML Model Paths ---
MODEL_PATH=ml/models/fake_news_model.pkl
VECTORIZER_PATH=ml/models/tfidf_vectorizer.pkl
